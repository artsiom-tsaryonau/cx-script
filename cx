#!/usr/bin/env bash
# cx — C/C++ script runner with //GITHUB deps
set -euo pipefail

SCRIPT="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
shift
EXT="${SCRIPT##*.}"

case "$EXT" in
    c|cx)     CC=(gcc -O3 -I.); SRC_EXT=c ;;
    cpp|cppx) CC=(g++ -std=c++17 -O3 -pthread -I.); SRC_EXT=cpp ;;
esac

KEY="$(printf '%s' "$SCRIPT" | openssl dgst -sha256 | awk '{print $NF}')"
TMP_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cx/$KEY"
mkdir -p "$TMP_DIR"
cd "$TMP_DIR"

fetch() {
    local url=$1 out=$2
    [[ -s "$out" ]] && return
    curl -fsSL "$url" -o "$out"
}

SOURCES=()
while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*//GITHUB[[:space:]]+(H|HPP)[[:space:]]+([^[:space:]]+) ]] || continue
    kind=${BASH_REMATCH[1]}
    spec=${BASH_REMATCH[2]}

    owner=${spec%%/*}; rest=${spec#*/}
    repo=${rest%%/*};  rest=${rest#*/}
    ref=${rest%%/*};   stem=${rest#*/}
    base=$(basename "$stem")
    url="https://raw.githubusercontent.com/$owner/$repo/$ref/$stem"

    case "$kind" in
        H)
            fetch "$url.h" "$base.h"
            fetch "$url.c" "$base.c"
            SOURCES+=("$base.c")
            ;;
        HPP) fetch "$url.hpp" "$base.hpp" ;;
    esac
done <"$SCRIPT"

if [[ ! -x ./script || ./script -ot "$SCRIPT" ]]; then
    sed '1{/^#!/d;}' "$SCRIPT" >"input.$SRC_EXT"
    "${CC[@]}" ${SOURCES[@]+"${SOURCES[@]}"} "input.$SRC_EXT" -o script
fi

exec ./script "$@"
