#!/usr/bin/env bash
# cx — jbang-style C/C++ scripts
#
#   //DEPS conan:fmt/10.2.1
#   //DEPS conan:boost/1.85.0[header_only=True] AS Boost::headers
#   //DEPS vcpkg:fmt
#   //DEPS vcpkg:fmt/10.2.1
#   //DEPS vcpkg:boost[asio,filesystem]
#   //DEPS gh:robertmrk/jmespath.cpp/0.2.1 AS jmespath::jmespath
#   //DEPS gh:rxi/log.c/master/src/log
#   //DEPS gh:p-ranav/indicators/master/.../indicators.hpp
#
# CC / CXX — standard env vars for the C and C++ compiler commands.
# If unset, prefers clang/clang++ then gcc/g++.
#
set -euo pipefail

[[ $# -ge 1 ]] || { echo "usage: cx <script.{c,cpp}> [args...]" >&2; exit 2; }

CALLER_PWD="$(pwd)"
SCRIPT="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
shift
EXT="${SCRIPT##*.}"

case "$EXT" in
    c)   LANG_ID=C ;;
    cpp) LANG_ID=CXX ;;
    *) echo "cx: unsupported extension .$EXT (use .c or .cpp)" >&2; exit 1 ;;
esac

# --- toolchain (CC = C compiler, CXX = C++ compiler) -------------------------

find_compiler() {
    local override=$1; shift
    if [[ -n "$override" ]]; then
        command -v "$override" && return
        echo "cx: compiler '$override' not found on PATH" >&2
        exit 1
    fi
    local c
    for c in "$@"; do
        command -v "$c" && return
    done
    return 1
}

CC_BIN="$(find_compiler "${CC:-}" clang gcc)" || {
    echo "cx: no C compiler found (set CC or install clang/gcc)" >&2
    exit 1
}
CXX_BIN=""
if [[ "$LANG_ID" == CXX ]]; then
    CXX_BIN="$(find_compiler "${CXX:-}" clang++ g++)" || {
        echo "cx: no C++ compiler found (set CXX or install clang++/g++)" >&2
        exit 1
    }
fi

# --- cache -------------------------------------------------------------------

sha() { openssl dgst -sha256 "$@" | awk '{print $NF}'; }

ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/cx/$(printf '%s' "$SCRIPT" | sha)"
mkdir -p "$ROOT"
cd "$ROOT"

CONTENT_HASH="$(sha "$SCRIPT")"
STAMP="${CONTENT_HASH}|${CC_BIN}|${CXX_BIN}"
HAS_DEPS=0
grep -q '^[[:space:]]*//DEPS ' "$SCRIPT" && HAS_DEPS=1
BIN=./script
[[ $HAS_DEPS -eq 1 ]] && BIN=build/script

[[ -f .cx_stamp && $(<.cx_stamp) == "$STAMP" && -x $BIN ]] && exec "$BIN" "$CALLER_PWD" "$@"

FORCE_FETCH=1
[[ -f .cx_stamp && $(<.cx_stamp) == "$STAMP" ]] && FORCE_FETCH=0

CONAN=()       # ref|find|tgt
GIT=()         # owner|repo|tag|find|tgt|opts
GH_SOURCES=()
CONAN_OPTIONS=()  # pkg/*:key=val
VCPKG=()       # name|version|find|tgt|features

fetch() {
    local url=$1 out=$2
    [[ $FORCE_FETCH -eq 0 && -s "$out" ]] && return
    curl -fsSL "$url" -o "$out"
}

# prints find|tgt
resolve_as() {
    local def=$1 as=${2:-} find tgt
    if [[ -n "$as" ]]; then
        if [[ "$as" == *::* ]]; then
            find=${as%%::*}; tgt=$as
        else
            find=$as; tgt="$as::$as"
        fi
    else
        find=$def; tgt="$def::$def"
    fi
    find=${find//[^A-Za-z0-9_]/_}
    printf '%s|%s' "$find" "$tgt"
}

fetch_github_path() {
    local spec=$1 owner repo ref path base url r
    owner=${spec%%/*}; r=${spec#*/}
    repo=${r%%/*};     r=${r#*/}
    ref=${r%%/*};      path=${r#*/}
    base=$(basename "$path")
    url="https://raw.githubusercontent.com/$owner/$repo/$ref/$path"

    case "$base" in
        *.hpp|*.h|*.hh)
            fetch "$url" "$base"
            ;;
        *.c|*.cc|*.cpp|*.cxx)
            fetch "$url" "$base"
            GH_SOURCES+=("$base")
            ;;
        *)
            fetch "$url.h" "$base.h"
            fetch "$url.c" "$base.c"
            GH_SOURCES+=("$base.c")
            ;;
    esac
}

split_opts() {
    local opts=$1
    [[ -z "$opts" ]] && return
    local IFS=, o
    for o in $opts; do
        o=${o#"${o%%[![:space:]]*}"}
        o=${o%"${o##*[![:space:]]}"}
        [[ -n "$o" ]] && printf '%s\n' "$o"
    done
}

add_deps_ref() {
    local raw=$1 as=${2:-} opts=${3:-}
    local kind ref n pkg def pair find tgt owner repo tag r name ver

    case "$raw" in
        conan:*) kind=conan; ref=${raw#conan:} ;;
        vcpkg:*) kind=vcpkg; ref=${raw#vcpkg:} ;;
        gh:*)    kind=gh;    ref=${raw#gh:} ;;
        *)
            echo "cx: //DEPS needs conan:, vcpkg:, or gh: prefix — got: $raw" >&2
            exit 1
            ;;
    esac

    n=$(awk -F/ '{print NF}' <<<"$ref")

    if [[ "$kind" == conan ]]; then
        pkg=${ref%%/*}; pkg=${pkg%%@*}
        pair=$(resolve_as "$pkg" "$as")
        find=${pair%%|*}; tgt=${pair#*|}
        CONAN+=("$ref|$find|$tgt")
        while IFS= read -r o; do
            [[ -n "$o" ]] && CONAN_OPTIONS+=("$pkg/*:$o")
        done < <(split_opts "$opts")
        return
    fi

    if [[ "$kind" == vcpkg ]]; then
        name=${ref%%/*}
        [[ "$ref" == */* ]] && ver=${ref#*/} || ver=
        pair=$(resolve_as "$name" "$as")
        find=${pair%%|*}; tgt=${pair#*|}
        VCPKG+=("$name|$ver|$find|$tgt|$opts")
        return
    fi

    # gh: — 3 segments = FetchContent; 4+ = raw file(s)
    if [[ "$n" -eq 3 ]]; then
        owner=${ref%%/*}; r=${ref#*/}
        repo=${r%%/*}; tag=${r#*/}
        def=${repo%.cpp}; def=${def%.c}
        pair=$(resolve_as "$def" "$as")
        find=${pair%%|*}; tgt=${pair#*|}
        GIT+=("$owner|$repo|$tag|$find|$tgt|$opts")
        return
    fi

    if [[ "$n" -ge 4 ]]; then
        fetch_github_path "$ref"
        return
    fi

    echo "cx: gh: ref needs owner/repo/ref or owner/repo/ref/path — got: $ref" >&2
    exit 1
}

while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*//DEPS[[:space:]]+([^[:space:]\[]+)(\[([^\]]*)\])?([[:space:]]+AS[[:space:]]+([^[:space:]]+))?[[:space:]]*$ ]] || continue
    add_deps_ref "${BASH_REMATCH[1]}" "${BASH_REMATCH[5]:-}" "${BASH_REMATCH[3]:-}"
done <"$SCRIPT"

if [[ ${#CONAN[@]} -gt 0 && ${#VCPKG[@]} -gt 0 ]]; then
    for entry in "${CONAN[@]}"; do
        IFS='|' read -r ref find tgt <<<"$entry"
        pkg=${ref%%/*}; pkg=${pkg%%@*}
        for ventry in "${VCPKG[@]}"; do
            IFS='|' read -r vname ver vfind vtgt feats <<<"$ventry"
            if [[ "$pkg" == "$vname" ]]; then
                echo "cx: package '$pkg' requested from both conan: and vcpkg: — pick one" >&2
                exit 1
            fi
        done
    done
fi

sed '1{/^#!/d;}' "$SCRIPT" >"script.$EXT"

json_str() {
    local s=$1
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "$s"
}

cmake_build() {
    local entry ref find tgt srcs="" links="" finds="" requires="" fetch_block="" options_block=""
    local owner repo tag opts o var val
    local name ver feats feat feat_json deps_json="" overrides_json="" first ffirst
    local need_configure=0 vcpkg_toolchain="" baseline=""
    local -a cmake_args

    for entry in ${CONAN[@]+"${CONAN[@]}"}; do
        IFS='|' read -r ref find tgt <<<"$entry"
        requires+="$ref"$'\n'
        finds+="find_package($find REQUIRED)"$'\n'
        links+=" $tgt"
    done

    for entry in ${CONAN_OPTIONS[@]+"${CONAN_OPTIONS[@]}"}; do
        options_block+="$entry"$'\n'
    done

    for entry in ${VCPKG[@]+"${VCPKG[@]}"}; do
        IFS='|' read -r name ver find tgt feats <<<"$entry"
        finds+="find_package($find REQUIRED)"$'\n'
        links+=" $tgt"
    done

    for entry in ${GIT[@]+"${GIT[@]}"}; do
        IFS='|' read -r owner repo tag find tgt opts <<<"$entry"
        while IFS= read -r o; do
            [[ -z "$o" ]] && continue
            var=${o%%=*}; val=${o#*=}
            var=$(printf '%s' "$var" | tr '[:lower:]' '[:upper:]')
            case "$val" in
                True|true|ON|on|1) val=ON ;;
                False|false|OFF|off|0) val=OFF ;;
            esac
            fetch_block+="set(${var} ${val} CACHE BOOL \"\" FORCE)"$'\n'
        done < <(split_opts "$opts")
        fetch_block+="FetchContent_Declare(${find}
  GIT_REPOSITORY https://github.com/${owner}/${repo}.git
  GIT_TAG ${tag})
FetchContent_MakeAvailable(${find})
"
        links+=" $tgt"
    done

    for src in ${GH_SOURCES[@]+"${GH_SOURCES[@]}"}; do
        srcs+=" $src"
    done

    local cxx_std="" need_fetch=""
    [[ "$LANG_ID" == CXX ]] && cxx_std='
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)'
    [[ -n "$fetch_block" ]] && need_fetch='include(FetchContent)'

    cat >CMakeLists.txt.new <<EOF
cmake_minimum_required(VERSION 3.15)
project(cx_script LANGUAGES ${LANG_ID})
$cxx_std
$need_fetch
$finds
$fetch_block
add_executable(script script.${EXT}${srcs})
target_link_libraries(script PRIVATE${links})
target_include_directories(script PRIVATE \${CMAKE_CURRENT_SOURCE_DIR})
EOF
    if [[ ! -f CMakeLists.txt ]] || ! cmp -s CMakeLists.txt.new CMakeLists.txt; then
        mv CMakeLists.txt.new CMakeLists.txt
        need_configure=1
    else
        rm -f CMakeLists.txt.new
    fi

    mkdir -p build

    if [[ ${#CONAN[@]} -gt 0 ]]; then
        {
            echo '[requires]'
            printf '%s' "$requires"
            if [[ -n "$options_block" ]]; then
                echo
                echo '[options]'
                printf '%s' "$options_block"
            fi
            echo
            echo '[generators]'
            echo 'CMakeDeps'
            echo 'CMakeToolchain'
        } >conanfile.txt.new
        if [[ ! -f build/conan_toolchain.cmake ]] \
            || [[ ! -f conanfile.txt ]] \
            || ! cmp -s conanfile.txt.new conanfile.txt; then
            mv conanfile.txt.new conanfile.txt
            conan install . -of build --build=missing -s build_type=Release
            need_configure=1
        else
            rm -f conanfile.txt.new
        fi
    fi

    if [[ ${#VCPKG[@]} -gt 0 ]]; then
        [[ -n "${VCPKG_ROOT:-}" ]] || {
            echo "cx: VCPKG_ROOT must point at a bootstrapped vcpkg for vcpkg: deps" >&2
            exit 1
        }
        vcpkg_toolchain="$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake"
        [[ -f "$vcpkg_toolchain" ]] || {
            echo "cx: missing vcpkg toolchain: $vcpkg_toolchain" >&2
            exit 1
        }

        first=1
        for entry in "${VCPKG[@]}"; do
            IFS='|' read -r name ver find tgt feats <<<"$entry"
            feat_json=""
            if [[ -n "$feats" ]]; then
                ffirst=1
                feat_json="["
                while IFS= read -r feat; do
                    [[ -z "$feat" ]] && continue
                    [[ $ffirst -eq 1 ]] || feat_json+=", "
                    feat_json+=$(json_str "$feat")
                    ffirst=0
                done < <(split_opts "$feats")
                feat_json+="]"
            fi

            [[ $first -eq 1 ]] || deps_json+=", "
            if [[ -n "$feat_json" ]]; then
                deps_json+="{ \"name\": $(json_str "$name"), \"features\": $feat_json }"
            else
                deps_json+=$(json_str "$name")
            fi
            first=0

            if [[ -n "$ver" ]]; then
                [[ -z "$overrides_json" ]] || overrides_json+=", "
                overrides_json+="{ \"name\": $(json_str "$name"), \"version\": $(json_str "$ver") }"
            fi
        done

        if [[ -n "$overrides_json" ]]; then
            baseline=$(git -C "$VCPKG_ROOT" rev-parse HEAD 2>/dev/null) || {
                echo "cx: cannot read builtin-baseline from VCPKG_ROOT ($VCPKG_ROOT); need a git checkout" >&2
                exit 1
            }
        fi

        {
            echo '{'
            printf '  "dependencies": [ %s ]' "$deps_json"
            if [[ -n "$overrides_json" ]]; then
                printf ',\n  "overrides": [ %s ],\n  "builtin-baseline": %s' \
                    "$overrides_json" "$(json_str "$baseline")"
            fi
            echo
            echo '}'
        } >vcpkg.json.new
        if [[ ! -f vcpkg.json ]] || ! cmp -s vcpkg.json.new vcpkg.json; then
            mv vcpkg.json.new vcpkg.json
            need_configure=1
        else
            rm -f vcpkg.json.new
        fi
    fi

    cmake_args=(-S . -B build -DCMAKE_BUILD_TYPE=Release)
    if [[ ${#VCPKG[@]} -gt 0 ]]; then
        cmake_args+=(-DCMAKE_TOOLCHAIN_FILE="$vcpkg_toolchain")
        [[ ${#CONAN[@]} -gt 0 ]] && \
            cmake_args+=(-DVCPKG_CHAINLOAD_TOOLCHAIN_FILE="$ROOT/build/conan_toolchain.cmake")
    elif [[ ${#CONAN[@]} -gt 0 ]]; then
        cmake_args+=(-DCMAKE_TOOLCHAIN_FILE=build/conan_toolchain.cmake)
    fi
    # Conan profile owns the compiler when Conan is present.
    if [[ ${#CONAN[@]} -eq 0 ]]; then
        cmake_args+=(-DCMAKE_C_COMPILER="$CC_BIN")
        [[ -n "$CXX_BIN" ]] && cmake_args+=(-DCMAKE_CXX_COMPILER="$CXX_BIN")
    fi

    if [[ $need_configure -eq 1 || ! -f build/Makefile && ! -f build/build.ninja ]]; then
        cmake "${cmake_args[@]}"
    fi
    cmake --build build
}

if [[ $HAS_DEPS -eq 1 ]]; then
    cmake_build
else
    if [[ "$LANG_ID" == CXX ]]; then
        "$CXX_BIN" -std=c++17 -O3 -pthread -I. "script.$EXT" -o script
    else
        "$CC_BIN" -O3 -I. "script.$EXT" -o script
    fi
fi

printf '%s\n' "$STAMP" >.cx_stamp
exec "$BIN" "$CALLER_PWD" "$@"
